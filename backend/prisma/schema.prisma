generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  AUTHORITY
  ADMIN
}

enum Status {
  PENDING
  IN_PROGRESS
  FIXED
  REJECTED
}

model User {
  id              String    @id @default(uuid())
  name            String
  email           String?   @unique
  phone           String    @unique
  password        String
  role            Role      @default(USER)
  address         Json
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  refreshToken    String?
  refreshTokenExp DateTime?

  authorityStaff AuthorityStaff?
  Report         Report[]
  Notification   Notification[]
}

model AuthorityOffice {
  id             Int               @id @default(autoincrement())
  officeName     String
  email          String
  phone          String            @unique
  address        Json
  iconUrl        String
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  parentOfficeId Int?
  parentOffice   AuthorityOffice?  @relation("OfficeHierarchy", fields: [parentOfficeId], references: [id])
  childOffices   AuthorityOffice[] @relation("OfficeHierarchy")

  categories     Category[]
  authorityStaff AuthorityStaff[]
  Report         Report[]
}

model Category {
  id          Int    @id @default(autoincrement())
  name        String
  description String

  authorityOffices AuthorityOffice[]
  Report           Report[]
}

model AuthorityStaff {
  position          String @default("Staff")
  userId            String @id
  authorityOfficeId Int

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorityOffice AuthorityOffice @relation(fields: [authorityOfficeId], references: [id], onDelete: Cascade)
}

model Report {
  id                String                                @id @default(uuid())
  location          Unsupported("geography(Point,4326)")?
  address           Json
  description       String
  photoUrls         String[]
  status            Status                                @default(PENDING)
  reporterConfirm   Boolean                               @default(false)
  communityConfirm  Int                                   @default(0)
  message           String
  submittedAt       DateTime                              @default(now())
  updatedAt         DateTime                              @updatedAt
  closedAt          DateTime?
  userId            String?
  authorityOfficeId Int?
  categoryId        Int?

  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  authorityOffice AuthorityOffice? @relation(fields: [authorityOfficeId], references: [id], onDelete: SetNull)
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  Notification    Notification[]
}

model Notification {
  id       String   @id @default(uuid())
  message  String
  isSeen   Boolean  @default(false)
  sentAt   DateTime @default(now())
  userId   String
  reportId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}
