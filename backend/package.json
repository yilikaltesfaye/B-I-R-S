{
	"name": "birs-backend",
	"version": "1.0.0",
	"description": "Broken infrastructure reporting system backend",
	"license": "ISC",
	"author": "Yilikal Tesfaye",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev:docker": "docker compose up -d dev_db redis",
		"dev:docker_down": "docker compose down",
		"dev:docker_reset": "docker compose down -v",
		"dev": "tsx watch src/app.ts",
		"clean": "rimraf dist",
		"build": "npm run clean && prisma generate && tsc",
		"prestart": "npm run build ",
		"start": "node dist/app.js",
		"prod": "cross-env NODE_ENV=production npx prisma generate && npm run start",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test": "jest",
		"test:watch": "jest --watch",
		"db:migrate": "prisma migrate dev",
		"db:generate": "prisma generate",
		"db:deploy": "prisma migrate deploy",
		"db:studio": "prisma studio"
	},
	"dependencies": {
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^7.10.0",
		"axios": "^1.20.0",
		"bcryptjs": "^3.0.3",
		"cloudinary": "^2.11.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^18.0.4",
		"express": "^5.2.1",
		"express-rate-limit": "^8.7.0",
		"ioredis": "^6.0.0",
		"jsonwebtoken": "^9.0.3",
		"morgan": "^1.12.1",
		"multer": "^2.4.0",
		"nanoid": "^6.0.1",
		"pg": "^8.23.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.2.0",
		"@types/node": "^26.6.3",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.2.1",
		"cross-env": "^10.1.0",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-node": "^11.1.0",
		"jest": "^30.5.2",
		"nodemon": "^3.1.14",
		"prettier": "^3.9.9",
		"prisma": "^7.10.0",
		"rimraf": "^6.1.3",
		"supertest": "^7.3.0",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2"
	},
	"overrides": {
		"mysql2": "^3.23.1",
		"deepmerge-ts": "^8.0.0"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"@prisma/engines@7.10.0": true,
		"esbuild@0.28.2": true,
		"prisma@7.10.0": true,
		"unrs-resolver@1.12.2": true
	}
}
